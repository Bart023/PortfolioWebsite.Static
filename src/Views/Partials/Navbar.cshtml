@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    var root = Model?.Root();
    var children = root?.Children()?.Where(x => x.IsVisible()) ?? Enumerable.Empty<IPublishedContent>();

    IPublishedContent? Find(string name) =>
        children.FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.InvariantCultureIgnoreCase));

    var home = root;
    var about = Find("About me");
    var projects = Find("Portfolio");
    var skills = Find("My skills");
    var contact = Find("Contact");
}

<nav class="navbar navbar-expand-lg">
    <div class="container">

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand" href="@home?.Url()">Bart van der Burg</a>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@(about?.Url() ?? "#")">Over mij</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@(projects?.Url() ?? "#")">Portfolio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@(skills?.Url() ?? "#")">Vaardigheden</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@(contact?.Url() ?? "#")">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>