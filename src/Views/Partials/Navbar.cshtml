@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    var root = Model?.Root();
    var children = root?.Children()?.Where(x => x.IsVisible()) ?? Enumerable.Empty<IPublishedContent>();

    IPublishedContent? Find(string name) =>
        children.FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.InvariantCultureIgnoreCase));

    var home = root;
    var about = Find("About me");
    var projects = Find("My work");
    var skills = Find("My skills");
    var contact = Find("Contact");

    bool IsActive(IPublishedContent? n) => 
        n != null && Model!.AncestorsOrSelf().Any(a => a.Id == n.Id);
}

<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container">

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand" href="@home?.Url()">@root?.Name</a>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link @(IsActive(home) ? "active" : "")" href="@(home?.Url() ?? " #")">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive(about) ? "active" : "")" href="@(about?.Url() ?? "#")">About me</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive(about) ? "active" : "")" href="@(projects?.Url() ?? "#")">My projects</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive(about) ? "active" : "")" href="@(skills?.Url() ?? "#")">My skills</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive(about) ? "active" : "")" href="@(contact?.Url() ?? "#")">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
