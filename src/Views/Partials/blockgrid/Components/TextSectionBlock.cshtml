@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@{
    var heading = Model.Content.Value<string>("title");
    var body = Model.Content.Value<string>("body");
    var imageAlign = Model.Content.Value<string>("imageAllign");
    var image = Model.Content.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("image");
}

<section class="container my-4">
    <div class="border rounded-3 p-4 bg-white shadow-sm">
        @if (imageAlign?.ToLower() == "center")
        {
            <div class="text-center mb-4">
                @if (image != null)
                {
                    <img src="@image.Url()" alt="@heading" class="img-fluid rounded mb-3" style="max-width: 500px;">
                }
                @if (!string.IsNullOrWhiteSpace(heading))
                {
                    <h2>@heading</h2>
                }
                <div>@Html.Raw(body)</div>
            </div>
        }
        else
        {
            <div class="row align-items-center g-4">
                @if (imageAlign?.ToLower() == "left" && image != null)
                {
                    <div class="col-md-5">
                        <img src="@image.Url()" alt="@heading" class="img-fluid rounded shadow-sm">
                    </div>
                }

                <div class="col-md-7">
                    @if (!string.IsNullOrWhiteSpace(heading))
                    {
                        <h2>@heading</h2>
                    }
                    <div>@Html.Raw(body)</div>
                </div>

                @if (imageAlign?.ToLower() == "right" && image != null)
                {
                    <div class="col-md-5">
                        <img src="@image.Url()" alt="@heading" class="img-fluid rounded shadow-sm">
                    </div>
                }
            </div>
        }
    </div>
</section>