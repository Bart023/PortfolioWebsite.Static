{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      }
    }
  },
  "x-static-build": {
    "TargetUrl": "/",
    "AdditionalUrls": [ "/" ],
    "SiteUrl": "localhost:44376",
    "OutputFolder": "C:\\Projects\\MyPortfolioWebsite\\docs",
    "StringReplacements": [
      {
        "OldValue": "http://localhost:52519/",
        "NewValue": "/"
      },
      {
        "OldValue": "https://localhost:44376/",
        "NewValue": "/"
      }
    ]
  },
  "x-static-host": {
    "Url": "http://localhost:8888",
    "RelativePath":  "/docs"
  }
}
